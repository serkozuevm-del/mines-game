<!DOCTYPE html>
<html lang="ky">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mines Game</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #1a1b26;
            color: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
        }
        h1 { margin-bottom: 10px; }
        .grid {
            display: grid;
            grid-template-columns: repeat(5, 60px);
            grid-gap: 10px;
            margin-top: 20px;
        }
        .cell {
            width: 60px;
            height: 60px;
            background-color: #24283b;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            cursor: pointer;
            user-select: none;
        }
        .cell.open { background-color: #414868; }
        .btn {
            margin-top: 20px;
            padding: 10px 20px;
            font-size: 16px;
            background-color: #7aa2f7;
            border: none;
            color: black;
            font-weight: bold;
            border-radius: 5px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <h1>Mines Game</h1>
    <div class="grid" id="grid"></div>
    <button class="btn" onclick="restart()">Жаңы оюн</button>

    <script>
        const grid = document.getElementById('grid');
        function restart() {
            grid.innerHTML = '';
            for (let i = 0; i < 25; i++) {
                const cell = document.createElement('div');
                cell.className = 'cell';
                cell.onclick = () => {
                    if (!cell.classList.contains('open')) {
                        cell.classList.add('open');
                        cell.innerText = Math.random() < 0.2 ? '💣' : '💎';
                    }
                };
                grid.appendChild(cell);
            }
        }
        restart();
    </script>
</body>
</html>
